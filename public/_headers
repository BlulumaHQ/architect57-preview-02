# Cloudflare static-asset fallback only, scoped to platform hostnames.
# Workers, Pages middleware and Netlify Edge apply the conditional HTML policy.
# Lovable hosting does NOT process this file. Never add a global /* noindex.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex

https://:version.:worker.:account.workers.dev/*
  X-Robots-Tag: noindex

https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:branch.:project.pages.dev/*
  X-Robots-Tag: noindex
